    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "9": 36, "12": 48 },
    "radius": { "none": 0, "sm": 2, "md": 4, "lg": 6, "pill": 999 },
    "size": { "touch": 44, "buttonLg": 54, "buttonMd": 44, "chip": 40, "tabBar": 72, "fab": 56, "tile": [106, 128] },
    "font": { "display": "Archivo", "mono": "JetBrains Mono", "fallback": "system-ui, -apple-system, Roboto, sans-serif" },
    "type": {
      "display": { "size": 38, "line": 38, "weight": 850, "stretch": 112, "tracking": -0.02 },
      "h1": { "size": 22, "line": 24, "weight": 850, "stretch": 108, "tracking": -0.02 },
      "h2": { "size": 20, "line": 23, "weight": 850, "stretch": 108, "tracking": -0.02 },
      "h3": { "size": 17, "line": 21, "weight": 800, "stretch": 100, "tracking": -0.01 },
      "body": { "size": 15, "line": 22, "weight": 500 },
      "bodyStrong": { "size": 15, "line": 22, "weight": 800 },
      "small": { "size": 13, "line": 18, "weight": 600 },
      "caption": { "size": 12.5, "line": 17, "weight": 500 },
      "micro": { "size": 11, "line": 13, "weight": 800, "tracking": 0.1, "transform": "uppercase" },
      "mono": { "size": 12, "line": 14, "weight": 600, "tracking": 0.1, "family": "mono" },
      "monoBig": { "size": 44, "line": 44, "weight": 600, "tracking": -0.04, "family": "mono" },
      "monoHero": { "size": 64, "line": 64, "weight": 600, "tracking": -0.04, "family": "mono" }
    },
    "motion": { "fast": 120, "base": 200, "screen": 320, "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)" }
  },
  "semantic": {
    "color": {
      "surface": "paper.100", "surface.raised": "paper.50", "surface.sunken": "paper.200",
      "text.primary": "ink.900", "text.secondary": "ink.500", "text.onAccent": "paper.50", "text.onTape": "tape.900",
      "border.subtle": "paper.300", "border.strong": "ink.900",
      "accent": "denim.600", "accent.pressed": "denim.700", "accent.soft": "denim.100",
      "attention": "khaki.600", "attention.soft": "khaki.100",
      "positive": "olive.600", "positive.soft": "olive.100",
      "highlight": "tape.500", "highlight.soft": "tape.100",
      "danger": "alert.600", "danger.soft": "alert.100",
      "focus": "denim.600",
      "camera.surface": "night.900", "camera.raised": "night.800", "camera.sunken": "night.700", "camera.border": "night.600",
      "camera.text": "paper.100", "camera.textSecondary": "ink.300"
    },
    "space": { "gutter": "space.4+2", "cardPad": "space.4", "stackTight": "space.2", "stack": "space.3", "stackLoose": "space.5", "section": "space.9" },
    "elevation": { "sheet": "1px border.subtle top", "compositionGround": "ellipse 12% ink.900 blur 6" }
  },
  "rules": [
    "Components consume semantic tokens only; primitives are for defining semantics and for the canvas.",
    "Any value used twice is a token. No raw hex or px in components.",
    "khaki.600 is text only at >= 20px/800; below that use ink.500 for secondary text (contrast).",
    "Colours that must be distinguished also differ in lightness: accent (dark) / attention (mid) / highlight (light)."
  ]
