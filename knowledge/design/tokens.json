{
  "version": 1,
  "primitive": {
    "color": {
      "paper.50": "#FFFFFF", "paper.100": "#F4F2ED", "paper.200": "#ECE8DF", "paper.300": "#DDD8CE", "paper.400": "#CFC9BC",
      "ink.900": "#16202C", "ink.700": "#2E3947", "ink.500": "#5A6573", "ink.300": "#9AA6B5",
      "denim.700": "#1A3050", "denim.600": "#23406A", "denim.100": "#E4EAF3",
      "khaki.700": "#7C6135", "khaki.600": "#9C7B45", "khaki.100": "#F3ECDD",
      "olive.700": "#3A4720", "olive.600": "#4A5A28", "olive.100": "#E6EAD9",
      "tape.500": "#E7C766", "tape.900": "#3B3016", "tape.100": "#FFF8E0",
      "alert.600": "#8C3A2B", "alert.100": "#F6E3DE",
      "night.900": "#10151C", "night.800": "#1B222C", "night.700": "#242C38", "night.600": "#3C4757"
